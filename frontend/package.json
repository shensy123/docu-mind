{
  "name": "docu-mind-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "dev:mock": "vite --host --mode mock",
    "build": "npm run build-only",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "run-s lint:oxlint lint:eslint lint:style",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "lint:style": "stylelint src/**/*.{vue,scss,css}",
    "lint:fix": "run-s \"lint:oxlint -- --fix\" \"lint:eslint -- --fix\" \"lint:style -- --fix\"",
    "format": "prettier --write --cache src/"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.17.0",
    "element-plus": "^2.13.7",
    "pinia": "^3.0.4",
    "vue": "3.5.32",
    "vue-router": "^5.0.4",
    "vue-virtual-scroller": "^3.0.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "mockjs": "^1.1.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "prettier": "3.8.3",
    "sass": "^1.99.0",
    "stylelint": "^17.12.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "typescript": "~6.0.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.8",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "browserslist": [
    "last 2 versions",
    "> 0.5%",
    "not dead"
  ]
}
