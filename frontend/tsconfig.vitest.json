{
  "extends": "./tsconfig.app.json",

  // Override to include only test files and clear exclusions.
  // Application code imported in tests is automatically included via module resolution.
  // 注意:必须同时纳入 auto-imports.d.ts / components.d.ts —— 测试 import 拉入的源码文件
  // (如 store/conversation.ts、composables/useConversationChat.ts)依赖其中的全局声明,
  // 缺了会导致测试项目里 ref/defineStore/ElMessage 等解析失败。
  "include": [
    "src/**/__tests__/*",
    "env.d.ts",
    "src/types/auto-imports.d.ts",
    "src/types/components.d.ts"
  ],
  "exclude": [],

  "compilerOptions": {
    // Vitest runs in a different environment than the application code.
    // Adjust lib and types accordingly.
    // lib 说明:不能用 [] —— 那会连 ES 标准库一起剥掉,测试 import 的源码文件里
    // Array.prototype.at 等 ES2022 API 会解析失败(TS2550)。这里只给 ES2022、不给 DOM,
    // 既覆盖标准库,又保持测试项目无浏览器 DOM 全局(避免与 @types/node 的 setTimeout 等全局冲突)。
    // 若未来引入组件挂载类测试需要 DOM 类型,再按需加 "DOM" / "DOM.Iterable"。
    "lib": ["ES2022"],
    "types": ["node", "jsdom"],

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
